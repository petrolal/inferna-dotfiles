# Inferna GNOME theme metadata (read by gnome/apply-theme.sh)
#
# Palette derived from nixos/assets/wallpapers/inferna.jpeg:
#   Charred Stone (surfaces):
#     bg_deep     = #0d0908   (arch ink shadow)
#     bg_view     = #100c0a   (recessed view)
#     bg_window   = #15100e   (main window stone)
#     bg_sidebar  = #181210   (smoky ash sidebar)
#     bg_header   = #1d1512   (elevated headerbar / dialog)
#     bg_card     = #241a16   (cards / popovers / tiles)
#   Flames & Rune Ring (accents):
#     accent      = #d9381e   (molten vermilion / imp flame)
#     accent_hi   = #ff622e   (bright ember glow)
#     gold        = #f2a949   (candlelight / rune ring gold)
#     destructive = #c8231a   (deep crimson)
#   Parchment & Ash (text):
#     fg          = #f2e5d5   (warm parchment)
#     fg_bright   = #fff6eb   (candlelit ivory)
#     fg_muted    = #a69085   (smoky ash)
#
# Values:
#   COLOR_SCHEME : 'default' | 'prefer-dark' | 'prefer-light'
#   ACCENT_COLOR : 'blue' | 'teal' | 'green' | 'yellow' | 'orange' | 'red' | 'pink' | 'purple' | 'slate'
#   GTK_THEME    : 'adw-gtk3-dark' | 'adw-gtk3' | 'Adwaita'
#   WALLPAPER    : optional path relative to this theme folder (e.g. 'wallpaper.jpg');
#                  leave empty to use the declarative NixOS default wallpaper.
COLOR_SCHEME="prefer-dark"
ACCENT_COLOR="orange"
GTK_THEME="adw-gtk3-dark"
WALLPAPER=""
