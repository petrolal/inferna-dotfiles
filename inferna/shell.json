{
  "bar": {
    "centerAnchor": "",
    "id": "denon.shell",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "ddd, MMM d  \u00b7  h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "denon.clock",
          "verticalFormat": "h\nmm\nAP"
        },
        {
          "id": "denon.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "denon.agents"
        },
        {
          "id": "denon.workspaces"
        }
      ],
      "right": [
        {
          "id": "denon.tray",
          "pinned": [
            "snip"
          ]
        },
        {
          "id": "denon.studio"
        },
        {
          "id": "denon.glass",
          "studio": true
        },
        {
          "id": "denon.recess",
          "studio": true
        },
        {
          "id": "io.github.denonmaryland.tricky-tiles",
          "studio": true
        },
        {
          "id": "denon.monitor",
          "studio": true
        },
        {
          "id": "io.github.denonmaryland.theme-studio"
        },
        {
          "hotkey": "Alt_R",
          "id": "io.github.denonmaryland.softly",
          "hidden": true
        },
        {
          "id": "denon.network",
          "hidden": true
        },
        {
          "id": "denon.bluetooth",
          "hidden": true
        },
        {
          "id": "denon.audio",
          "hidden": true
        },
        {
          "id": "denon.dropbox",
          "hidden": true
        },
        {
          "id": "denon.power",
          "hidden": true
        },
        {
          "id": "denon.indicators",
          "items": [
            "StayAwake"
          ],
          "alwaysShow": true
        },
        {
          "id": "denon.corner"
        }
      ]
    },
    "position": "left",
    "transparent": false
  },
  "cloneSourceRestores": [
    "denon.battery",
    "denon.notifications",
    "denon.menu",
    "hello-lock",
    "denon.osd",
    "denon.polkit"
  ],
  "disabledPlugins": [
    "omarchy.battery",
    "omarchy.notifications",
    "omarchy.menu",
    "omarchy.lock",
    "omarchy.osd",
    "omarchy.polkit"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.denonmaryland.softly"
    },
    {
      "id": "denon.battery"
    },
    {
      "id": "denon.notifications"
    },
    {
      "id": "hello-lock"
    },
    {
      "id": "denon.osd"
    },
    {
      "id": "denon.polkit"
    },
    {
      "id": "denon.menu"
    }
  ],
  "version": 1
}
