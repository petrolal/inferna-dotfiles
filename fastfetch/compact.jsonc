      "format": "{#38;2;247;214;122}┃ {#38;2;138;22;12}◆ {#38;2;186;36;18}◆ {#38;2;226;62;26}◆ {#38;2;255;98;46}◆ {#38;2;245;140;54}◆ {#38;2;242;169;73}◆ {#38;2;245;204;122}◆ {#38;2;245;234;220}◆{#}"
