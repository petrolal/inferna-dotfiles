{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "pipe": false,
    "separator": "  ",
    "color": {
      "keys": "38;2;242;169;73",
      "title": "38;2;255;98;46",
      "output": "38;2;242;229;213",
      "separator": "38;2;140;106;90"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "━"
      },
      "border": null,
      "width": 10,
      "color": {
        "elapsed": "38;2;255;98;46",
        "total": "38;2;72;48;40"
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;242;169;73",
        "yellow": "38;2;255;122;46",
        "red": "38;2;224;54;32"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#38;2;196;48;22}╭─ {#1;38;2;255;98;46}󰈸 {user-name}{#0;38;2;148;116;102}@{#1;38;2;242;169;73}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;196;48;22}├────────────────────────────────────────────{#}"
    },
    {
      "type": "os",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}OS    {#}",
      "format": "{pretty-name} {#38;2;150;124;110}({arch}){#}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}Kernel{#}",
      "format": "{sysname} {release}"
    },
    {
      "type": "de",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}DE    {#}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}Term  {#}"
    },
    {
      "type": "command",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}󰈺  {#1;38;2;242;169;73}Shell {#}",
      "text": "if [ -n \"$INFERNA_SHELL\" ]; then printf '%s' \"$INFERNA_SHELL\"; else fish --version | sed 's/, version / /'; fi"
    },
    {
      "type": "uptime",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}󰔟  {#1;38;2;242;169;73}Uptime{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;140;46;26}├─ ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄{#}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}CPU   {#}",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}󰢮  {#1;38;2;242;169;73}GPU   {#}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}  {#1;38;2;242;169;73}Mem   {#}",
      "format": "{used} / {total}  {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "key": "{#38;2;196;48;22}│ {#38;2;255;98;46}󰋊  {#1;38;2;242;169;73}Disk  {#}",
      "folders": "/",
      "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
    },
    {
      "type": "custom",
      "format": "{#38;2;196;48;22}╰────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "format": "  {#38;2;140;24;16}● {#38;2;196;40;20}● {#38;2;230;68;28}● {#38;2;255;98;46}● {#38;2;242;146;54}● {#38;2;242;169;73}● {#38;2;245;204;122}● {#38;2;242;229;213}●{#}"
    }
  ]
}
