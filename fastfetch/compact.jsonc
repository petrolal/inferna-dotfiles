{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "pipe": false,
    "separator": "  ",
    "color": {
      "keys": "38;2;242;169;73",
      "title": "38;2;255;98;46",
      "output": "38;2;245;234;220",
      "separator": "38;2;140;106;90"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "━"
      },
      "border": null,
      "width": 10,
      "color": {
        "elapsed": "38;2;255;104;46",
        "total": "38;2;68;46;38"
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;242;169;73",
        "yellow": "38;2;255;118;46",
        "red": "38;2;224;50;28"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#38;2;138;22;12}┃ {#1;38;2;255;98;46}󰈸 {user-name}{#0;38;2;148;122;108}@{#1;38;2;242;169;73}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;163;29;16}┃ {#38;2;118;38;22}──────────────────────────────────────────────{#}"
    },
    {
      "type": "os",
      "key": "{#38;2;188;38;20}┃ {#38;2;255;98;46}  {#1;38;2;242;169;73}OS    {#}",
      "format": "{pretty-name} {#38;2;148;122;108}{arch}{#}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;209;49;24}┃ {#38;2;255;98;46}  {#1;38;2;242;169;73}Kernel{#}",
      "format": "{sysname} {release}"
    },
    {
      "type": "de",
      "key": "{#38;2;227;62;28}┃ {#38;2;255;98;46}  {#1;38;2;242;169;73}DE    {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;240;76;34}┃ {#38;2;255;98;46}  {#1;38;2;242;169;73}Term  {#}"
    },
    {
      "type": "command",
      "key": "{#38;2;250;90;40}┃ {#38;2;255;98;46}󰈺  {#1;38;2;242;169;73}Shell {#}",
      "text": "if [ -n \"$INFERNA_SHELL\" ]; then printf '%s' \"$INFERNA_SHELL\"; else fish --version | sed 's/, version / /'; fi"
    },
    {
      "type": "uptime",
      "key": "{#38;2;255;104;46}┃ {#38;2;255;98;46}󰔟  {#1;38;2;242;169;73}Uptime{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;255;118;52}┃{#}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;252;132;58}┃ {#38;2;232;68;32}  {#1;38;2;238;154;72}CPU   {#}",
      "format": "{name} {#38;2;148;122;108}({cores-logical}t){#}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;246;150;66}┃ {#38;2;232;68;32}󰢮  {#1;38;2;238;154;72}GPU   {#}",
      "format": "{vendor} {name} {#38;2;148;122;108}· {type}{#}"
    },
    {
      "type": "memory",
      "key": "{#38;2;242;173;76}┃ {#38;2;232;68;32}  {#1;38;2;238;154;72}Mem   {#}",
      "format": "{percentage-bar} {percentage} {#38;2;148;122;108}· {#38;2;245;234;220}{used} {#38;2;148;122;108}/ {total}{#}"
    },
    {
      "type": "disk",
      "key": "{#38;2;243;188;88}┃ {#38;2;232;68;32}󰋊  {#1;38;2;238;154;72}Disk  {#}",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} {#38;2;148;122;108}· {#38;2;245;234;220}{size-used} {#38;2;148;122;108}/ {size-total}{#}"
    },
    {
      "type": "battery",
      "key": "{#38;2;245;202;102}┃ {#38;2;232;68;32}󰁹  {#1;38;2;238;154;72}Power {#}",
      "format": "{capacity-bar} {capacity} {#38;2;148;122;108}· {#38;2;245;234;220}{status}{#}"
