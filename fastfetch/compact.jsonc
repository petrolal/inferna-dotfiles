{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;242;169;73",
      "title": "38;2;255;98;46"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;38;2;255;98;46}{user-name}{#0;38;2;166;144;133}@{#1;38;2;242;169;73}{host-name}{#}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;217;56;30"
    },
    {
      "type": "os",
      "key": "  OS    "
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰔟  Uptime"
    },
    {
      "type": "de",
      "key": "  DE    "
    },
    {
      "type": "terminal",
      "key": "  Term  "
    },
    {
      "type": "shell",
      "key": "󰈺  Shell "
    },
    {
      "type": "cpu",
      "key": "  CPU   ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU   ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  Mem   "
    },
    {
      "type": "disk",
      "key": "󰋊  Disk  ",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
