{
  description = "Inferna - Declarative NixOS configuration and desktop environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    antigravity-nix = {
      url = "github:jacopone/antigravity-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    claude-desktop = {
      url = "github:aaddrick/claude-desktop-debian";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      antigravity-nix,
      claude-desktop,
      ...
    }:
    let
      defaultSystem = "x86_64-linux";

      # Portable NixOS module that any machine can import from /etc/nixos/flake.nix
      # (generated by bootstrap.sh) for 100% pure, per-machine evaluation.
      infernaModule =
        {
          config,
          lib,
          pkgs,
          ...
        }:
        {
          imports = [ ./configuration.nix ];

          options.dotfiles.antigravity.enable = lib.mkOption {
            type = lib.types.bool;
            default = true;
            description = "Install google-antigravity-cli from antigravity-nix.";
          };

          config = {
            nixpkgs.overlays = [ claude-desktop.overlays.default ];

            environment.systemPackages = lib.optional config.dotfiles.antigravity.enable (
              antigravity-nix.packages.${pkgs.stdenv.hostPlatform.system}.google-antigravity-cli
            );
          };
        };

      # Helper used both internally and by per-machine /etc/nixos/flake.nix wrappers.
      mkHost =
        {
          hostname,
          hardwareConfig,
          system ? defaultSystem,
          user ? null,
          extraModules ? [ ],
        }:
        nixpkgs.lib.nixosSystem {
          modules =
            [
              {
                nixpkgs.hostPlatform = system;
                networking.hostName = hostname;
              }
              hardwareConfig
              infernaModule
            ]
            ++ nixpkgs.lib.optional (user != null) { dotfiles.username = user; }
            ++ extraModules;
        };

      # Primary workstation host (Intel + NVIDIA RTX 4050 Laptop PRIME offload).
      primary = mkHost {
        hostname = "abatedouro-de-anoes-PC";
        hardwareConfig = ./hardware-configuration.nix;
        extraModules = [
          {
            dotfiles = {
              flakePath = "/home/petrolal/inferna-dotfiles/nixos";
              gpu.vendor = "hybrid-intel-nvidia";
              nvidia = {
                enable = true;
                cudaCapabilities = [ "8.9" ];
                prime = {
                  intelBusId = "PCI:0:2:0";
                  nvidiaBusId = "PCI:1:0:0";
                };
              };
            };
          }
        ];
      };

      # Portable reference host (no NVIDIA/PCI IDs, suitable for generic x86_64 evaluation).
      generic = mkHost {
        hostname = "inferna-nixos";
        hardwareConfig = {
          fileSystems."/" = {
            device = "/dev/disk/by-label/nixos";
            fsType = "ext4";
          };
        };
        extraModules = [
          {
            dotfiles = {
              gpu.vendor = "generic";
              nvidia.enable = false;
            };
          }
        ];
      };

      # Pure evaluation smoke-test configurations for `nix flake check`.
      checkGenericMinimal = mkHost {
        hostname = "inferna-vm-test";
        hardwareConfig = {
          fileSystems."/" = {
            device = "/dev/vda1";
            fsType = "ext4";
          };
        };
        extraModules = [
          {
            dotfiles = {
              username = "tester";
              userDescription = "Test User";
              bootloader = "systemd-boot";
              gpu.vendor = "vm";
              gaming.enable = false;
              ollama.enable = false;
              development.enable = false;
              containers.enable = false;
              antigravity.enable = false;
              packages = {
                creative3d.enable = false;
                devExtras.enable = false;
                dailyApps.enable = false;
              };
            };
          }
        ];
      };

      checkAmdNvidiaGrub = mkHost {
        hostname = "inferna-amd-nvidia-test";
        hardwareConfig = {
          fileSystems."/" = {
            device = "/dev/sda1";
            fsType = "ext4";
          };
        };
        extraModules = [
          {
            dotfiles = {
              username = "tester";
              bootloader = "grub";
              grubDevice = "/dev/sda";
              gpu.vendor = "hybrid-amd-nvidia";
              nvidia = {
                enable = true;
                prime = {
                  amdgpuBusId = "PCI:5:0:0";
                  nvidiaBusId = "PCI:1:0:0";
                };
              };
            };
          }
        ];
      };

      checkNvidiaDesktop = mkHost {
        hostname = "inferna-nvidia-desktop-test";
        hardwareConfig = {
          fileSystems."/" = {
            device = "/dev/nvme0n1p2";
            fsType = "ext4";
          };
        };
        extraModules = [
          {
            dotfiles = {
              username = "tester";
              gpu.vendor = "nvidia";
              nvidia = {
                enable = true;
                open = false;
              };
            };
          }
        ];
      };

      pkgs = nixpkgs.legacyPackages.${defaultSystem};
      mkEvalCheck =
        name: cfg:
        let
          failedAssertions = builtins.map (x: x.message) (
            builtins.filter (x: !x.assertion) cfg.config.assertions
          );
          checked =
            if failedAssertions != [ ] then
              throw "Check '${name}' failed assertions:\n- ${builtins.concatStringsSep "\n- " failedAssertions}"
            else
              builtins.toJSON {
                hostname = cfg.config.networking.hostName;
                bootloader = cfg.config.dotfiles.bootloader;
                gpuVendor = cfg.config.dotfiles.gpu.vendor;
                nvidiaEnable = cfg.config.dotfiles.nvidia.enable;
                nvidiaPrime = cfg.config.hardware.nvidia.prime.offload.enable;
                earlyKms = cfg.config.boot.initrd.kernelModules;
                firstLogin = cfg.config.systemd.user.services ? inferna-first-login;
                etcDrv = builtins.unsafeDiscardStringContext cfg.config.system.build.etc.drvPath;
              };
        in
        pkgs.runCommand "check-${name}" { } ''
          printf '%s\n' ${nixpkgs.lib.escapeShellArg checked} > "$out"
        '';
    in
    {
      nixosModules.default = infernaModule;

      lib = {
        inherit mkHost;
      };

      nixosConfigurations = {
        "abatedouro-de-anoes-PC" = primary;
        default = primary;
        inherit generic;
      };

      formatter.${defaultSystem} = pkgs.nixfmt;

      checks.${defaultSystem} = {
        statix = pkgs.runCommand "statix-check" { } ''
          ${pkgs.statix}/bin/statix check --config ${./.} ${./.}
          touch $out
        '';
        eval-primary = mkEvalCheck "eval-primary" primary;
        eval-generic-minimal = mkEvalCheck "eval-generic-minimal" checkGenericMinimal;
        eval-amd-nvidia-grub = mkEvalCheck "eval-amd-nvidia-grub" checkAmdNvidiaGrub;
        eval-nvidia-desktop = mkEvalCheck "eval-nvidia-desktop" checkNvidiaDesktop;
      };
    };
}
