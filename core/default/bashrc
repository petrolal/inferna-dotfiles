# Inferna environment (INFERNA_PATH + PATH), needed even for non-interactive shells
export INFERNA_PATH="${INFERNA_PATH:-$HOME/inferna-dotfiles/core}"
export INFERNA_PATH="$INFERNA_PATH"
[[ -r "$INFERNA_PATH/default/bash/env-bootstrap" ]] && source "$INFERNA_PATH/default/bash/env-bootstrap"

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Inferna aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$INFERNA_PATH/default/bash/rc"

