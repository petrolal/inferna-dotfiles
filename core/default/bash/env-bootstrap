# Single source of truth for INFERNA_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/inferna.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-inferna          (Hyprland session via uwsm)
#   /usr/share/inferna/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/inferna.conf is written by inferna-dev-link and reset by
# inferna-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -n "${INFERNA_PATH:-}" ]; then
  : "${INFERNA_PATH:=$INFERNA_PATH}"
elif [ -f /etc/inferna.conf ]; then
  . /etc/inferna.conf
  : "${INFERNA_PATH:=/usr/share/inferna}"
  INFERNA_PATH="$INFERNA_PATH"
elif [ -f /etc/inferna.conf ]; then
  . /etc/inferna.conf
  : "${INFERNA_PATH:=/usr/share/inferna}"
  INFERNA_PATH="$INFERNA_PATH"
else
  INFERNA_PATH="${HOME:-/root}/inferna-dotfiles/core"
  INFERNA_PATH="$INFERNA_PATH"
fi
export INFERNA_PATH
export INFERNA_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/inferna-* via the inferna package — prepending
# /usr/share/inferna/bin would just be noise.
if [ "$INFERNA_PATH" != /usr/share/inferna ]; then
  case ":$PATH:" in
    *":${INFERNA_PATH%/}/bin:"*) ;;
    *) PATH="${INFERNA_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
inferna_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
inferna_wrapper_path=$inferna_wrapper_dir
if [ -n "${PATH:-}" ]; then
  inferna_remaining_path=$PATH
  while :; do
    inferna_path_entry=${inferna_remaining_path%%:*}
    if [ "$inferna_path_entry" != "$inferna_wrapper_dir" ]; then
      inferna_wrapper_path="$inferna_wrapper_path:$inferna_path_entry"
    fi
    case "$inferna_remaining_path" in
      *:*) inferna_remaining_path=${inferna_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$inferna_wrapper_path
unset inferna_wrapper_dir inferna_wrapper_path inferna_remaining_path inferna_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
