#!/usr/bin/env bash

# inferna:summary=Toggle animations, blur and shadows, which are slow without a GPU
# inferna:args=[toggle|on|off]
# inferna:examples=inferna toggle animations | inferna toggle animations off | inferna toggle animations on

case ${1:-toggle} in
toggle)
  if inferna-hyprland-animations-off; then
    animations=on
  else
    animations=off
  fi
  ;;
on | off) animations=$1 ;;
*)
  echo "Usage: inferna-toggle-animations [toggle|on|off]" >&2
  exit 1
  ;;
esac

# A session that renders on the CPU turns animations off by itself
# (default/hypr/software-rendering.lua). Turning them on there is remembered for
# later sessions too, and has to be in place before the toggle reloads Hyprland.
without_gpu="$HOME/.local/state/inferna/toggles/animations-without-gpu"

# The flag records animations being off, so on and off swap on the way through.
if [[ $animations == "on" ]]; then
  if [[ -e $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/inferna-software-rendering ]]; then
    mkdir -p "${without_gpu%/*}"
    touch "$without_gpu"
  fi
  inferna-hyprland-toggle no-animations off
else
  rm -f "$without_gpu"
  inferna-hyprland-toggle no-animations on
fi

if inferna-hyprland-animations-off; then
  inferna-notification-send -g 󰗘 "$(inferna-i18n animations.disabled)"
else
  inferna-notification-send -g 󰗘 "$(inferna-i18n animations.enabled)"
fi
