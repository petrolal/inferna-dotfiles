#!/usr/bin/env bash

# inferna:summary=Sync Inferna theme to all Obsidian vaults
# inferna:hidden=true

CURRENT_THEME_DIR="$HOME/.local/state/inferna/current/theme"

[[ -f $CURRENT_THEME_DIR/obsidian.css ]] || exit 0

jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
  [[ -d $vault_path/.obsidian ]] || continue

  theme_dir="$vault_path/.obsidian/themes/Inferna"
  mkdir -p "$theme_dir"

  [[ -f $theme_dir/manifest.json ]] || cat >"$theme_dir/manifest.json" <<'EOF'
{
  "name": "Inferna",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current Inferna system theme colors and fonts",
  "author": "Inferna",
  "authorUrl": "https://github.com/petrolal/dotfiles"
}
EOF

  cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css"
done
