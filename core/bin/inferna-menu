#!/usr/bin/env bash

# inferna:summary=Control the Omarchy menu (toggle / summon / close / refresh)
# inferna:args=[toggle|summon|close|refresh|ping] [route]
# inferna:examples=inferna menu | inferna menu toggle system | inferna menu summon appearance.theme | inferna menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `omarchy.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec inferna-shell shell toggle omarchy.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec inferna-shell shell summon omarchy.menu "$(menu_payload "$route")"
    ;;
  close)
    exec inferna-shell shell hide omarchy.menu
    ;;
  refresh | ping)
    exec inferna-shell shell call omarchy.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: inferna menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "inferna-menu: unknown verb '$verb'. Try 'omarchy menu --help'." >&2
    exit 2
    ;;
esac
