#!/usr/bin/env bash

# inferna:summary=Toggle suspend availability in the system menu

if inferna-sleep-disabled; then
  inferna-notification-send -g 󰒲 "$(inferna-i18n suspend.turnedOffOnMachine)"
  exit 0
fi

inferna-toggle suspend-off

if inferna-toggle-enabled suspend-off; then
  inferna-notification-send -g 󰒲 "$(inferna-i18n suspend.removedFromMenu)"
else
  inferna-notification-send -g 󰒲 "$(inferna-i18n suspend.availableInMenu)"
fi
