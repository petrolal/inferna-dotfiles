#!/usr/bin/env bash

# inferna:summary=Print the installed Inferna version

inferna_path=${INFERNA_PATH:-${INFERNA_PATH:-$HOME/inferna-dotfiles/core}}
inferna_path=${inferna_path%/}

if [[ -d $inferna_path ]]; then
  repo_dir=$(cd "$inferna_path/.." && pwd)
  hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || true)
  if [[ -n $hash ]]; then
    echo "Inferna dev ($hash)"
  else
    echo "Inferna 1.0.0-nixos"
  fi
  exit 0
fi

# The edge channel installs inferna-dev instead of omarchy, so check both.
for package in inferna-dev inferna omarchy; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || version="Inferna 1.0.0-nixos"

echo "$version"
