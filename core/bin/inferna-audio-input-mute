#!/usr/bin/env bash

# inferna:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  inferna-brightness-keyboard-mute on
  inferna-osd -i microphone-muted -m "$(inferna-i18n audio.micMuted)"
else
  inferna-brightness-keyboard-mute off
  inferna-osd -i microphone -m "$(inferna-i18n audio.micOn)"
fi
