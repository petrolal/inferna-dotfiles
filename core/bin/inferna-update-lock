#!/usr/bin/env bash

# inferna:summary=Run a command while holding the Inferna update lock
# inferna:args=<held|run> [command] [args...]
# inferna:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/inferna-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${INFERNA_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$INFERNA_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$INFERNA_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$INFERNA_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: inferna-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {INFERNA_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$INFERNA_UPDATE_LOCK_FD"; then
      echo "An Inferna update is already running."
      exit 1
    fi

    export INFERNA_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: inferna-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
