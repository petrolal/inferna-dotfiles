#!/usr/bin/env bash

# inferna:summary=Launch or focus on a given web app identified by the window-pattern.
# inferna:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: inferna-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="inferna-launch-webapp $@"

exec inferna-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
