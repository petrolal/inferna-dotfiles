#!/usr/bin/env bash

# inferna:summary=Run open models on this machine for your agents
# inferna:args=<use|list|status|start|stop|remove> [args]
# inferna:examples=inferna agent local use best | inferna agent local use qwen3.8-27b-gufo | inferna agent local stop | inferna-agent-local use --help

# The engine and its recipes come in inferna-local-ai, on every machine so the
# agents panel knows which models fit. Podman, which runs them, only comes when
# a model is first set up, from the terminal that setup runs in. An NVIDIA GPU
# reaches the containers through the CDI spec nvidia-container-toolkit writes
# on install and again at every boot.
if [[ ${1:-} == "use" ]]; then
  packages=(podman crun)
  if inferna-hw-nvidia; then
    packages+=(nvidia-container-toolkit)
  fi
  inferna-pkg-add "${packages[@]}" || exit 1
fi

exec inferna-local-ai "$@"
