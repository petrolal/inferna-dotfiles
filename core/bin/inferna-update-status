#!/usr/bin/env bash

# inferna:summary=Clear the shell update indicator after an update
# inferna:hidden=true

# inferna-update now clears the indicator itself. This stays for an update
# started by an older inferna-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
inferna-shell -q omarchy.system-update clear
