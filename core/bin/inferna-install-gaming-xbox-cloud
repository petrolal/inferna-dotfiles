#!/usr/bin/env bash

# inferna:summary=Install Xbox Cloud Gaming as a web app and launch it.
# inferna:group=install
# inferna:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
inferna-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid inferna-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
