#!/usr/bin/env bash

# inferna:summary=Choose which Claude, Codex, or Grok account new sessions use
# inferna:args=[claude|codex|grok] [account|next]
# inferna:examples=inferna agent account use work | inferna agent account use main | inferna agent account use codex next

set -uo pipefail

# The provider can be left out when it's your default agent:
# `inferna agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(inferna-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

case "${1:-}" in
claude) name="Claude" ;;
codex) name="Codex" ;;
grok) name="Grok" ;;
*)
  echo "Usage: inferna-agent-account-use [claude|codex|grok] [account|next]" >&2
  exit 1
  ;;
esac

result=$(inferna-agent-account-state use "$1" "${2:-next}") || exit 1

previous=$(jq -r .previous.label <<<"$result")
active=$(jq -r '.active.label + (if (.active.plan // "") != "" then " (" + .active.plan + ")" else "" end)' <<<"$result")
label=$(jq -r .active.label <<<"$result")

if [[ $(jq -r .previous.id <<<"$result") == "$(jq -r .active.id <<<"$result")" ]]; then
  echo "New $name sessions already use $active."
else
  message="Running sessions stay on $previous."
  echo "New $name sessions now use $active. $message"
  # The headline leaves out the plan, so it stays on one line.
  inferna-notification-send -g 󰚩 "$(inferna-i18n agents.newSessionsUse "$name" "$label")" "$(inferna-i18n agents.runningStayOn "$previous")"
  # The usage record's own limits describe the active account.
  inferna-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
fi
