#!/usr/bin/env bash

# inferna:summary=Print the active Inferna package channel

set -euo pipefail

# Dev is a linked source checkout: INFERNA_PATH points somewhere other than
# the package-backed install at /usr/share/omarchy. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $INFERNA_PATH != "/usr/share/omarchy" ]]; then
  echo dev
  exit 0
fi

# inferna-dev / inferna-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. omarchy / inferna-settings come
# from either the stable or rc mirror, distinguished by inferna-version-channel
# (which reports the mirror as its first token).
if pacman -Q inferna-dev inferna-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q omarchy inferna-settings >/dev/null 2>&1; then
  channel=$(inferna-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
