#!/usr/bin/env bash

# inferna:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Inferna default and rebuild it.
# inferna:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$INFERNA_PATH/bin/inferna-plymouth-set" --refresh-default
