#!/usr/bin/env bash -p

# inferna:summary=Detect whether the computer is an Apple Silicon Mac (the old name of inferna-hw-aarch64-apple).
# inferna:hidden=true

# Kept while inferna-mac's packages and units still call it by this name. Like
# the predicate it runs, it refuses a launch without -p and searches no PATH.
if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

dir=${BASH_SOURCE[0]%/*}
[[ $dir != "${BASH_SOURCE[0]}" ]] || dir=.
exec "$dir/inferna-hw-aarch64-apple"
