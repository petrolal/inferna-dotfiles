#!/usr/bin/env bash

# inferna:summary=Cycle to the next media source and transfer playback when the current source is playing
# inferna:args=[next|previous]
# inferna:examples=inferna audio source switch | inferna-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    inferna-shell media sourceSwitch
    ;;
  previous)
    inferna-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: inferna-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
