#!/usr/bin/env bash

# inferna:summary=Send the low battery warning notification and run battery-low hooks.
# inferna:args=<percentage>
# inferna:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: inferna-battery-low <percentage>" >&2
  exit 1
fi

level=$1

inferna-notification-send -g 󱐋 -u normal "$(inferna-i18n battery.lowTitle)" "$(inferna-i18n battery.lowBody "$level")" -i battery-caution -t 30000
inferna-hook battery-low "$level"
