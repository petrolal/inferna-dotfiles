#!/usr/bin/env bash

# inferna:summary=Launch a URL as a web app in the default supported browser
# inferna:args=<url>

browser=$(inferna-cmd-default-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

# Read Exec= from the same data dirs inferna-cmd-default-browser searched, as
# inferna-launch-browser does, so a browser it resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
browser_exec=""
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$browser"
  [[ -f $entry ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
  break
done

# Handing an empty command to uwsm-app surfaces as "Command not found: \"\"",
# which fails a keybinding silently. A web app runs in a Chromium-based
# browser, so say that rather than claiming no browser is set.
if [[ -z $browser_exec ]]; then
  echo "inferna-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'inferna install browser chromium'" >&2
  inferna-notification-send -u critical -g 󰖟 "$(inferna-i18n browser.webappNeedsChromium)" "$(inferna-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

if ! inferna-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- $browser_exec --app="$1" "${@:2}"
fi
