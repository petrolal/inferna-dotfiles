#!/usr/bin/env bash

# inferna:summary=Select a drive from a list with info that includes space and brand. Used by inferna-drive-password.

if (($# == 0)); then
  drives=$(lsblk -dpno NAME | grep -E '/dev/(sd|hd|vd|nvme|mmcblk|xv)')
else
  drives="$@"
fi

drives_with_info=""
while IFS= read -r drive; do
  [[ -n $drive ]] || continue
  drives_with_info+="$(inferna-drive-info "$drive")"$'\n'
done <<<"$drives"

selected_drive="$(printf "%s" "$drives_with_info" | gum choose --header "$(inferna-i18n drive.select)")" || exit 1
printf "%s\n" "$selected_drive" | awk '{print $1}'
