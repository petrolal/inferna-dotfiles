#!/usr/bin/env bash

# inferna:summary=Prompt for confirmation before starting an update

gum style --border normal --padding "1 2" \
  "$(inferna-i18n update.ready)" \
  "" \
  "• $(inferna-i18n update.cannotStop)" \
  "• $(inferna-i18n update.connectPower)" \
  "" \
  "$(inferna-i18n update.whatsNew "https://github.com/petrolal/dotfiles/releases/latest")"

echo

if ! gum confirm --affirmative "$(inferna-i18n common.yes)" --negative "$(inferna-i18n common.no)" "$(inferna-i18n update.continue)"; then
  echo "Update cancelled"
  exit 1
fi
