#!/usr/bin/env bash

# inferna:summary=Add packages to packages-adhoc.nix and rebuild
# inferna:args=<packages...>
# inferna:examples=inferna pkg add jq ripgrep
# inferna:requires-sudo=true

if ! flake_dir=$(inferna-nixos-flake-dir); then
  echo -e "\033[31mError: could not find a NixOS flake directory.\033[0m" >&2
  exit 1
fi
adhoc_file="$flake_dir/modules/packages-adhoc.nix"
added=()
for pkg in "$@"; do
  if grep -qE "^\s*${pkg}\s*$" "$adhoc_file"; then
    continue
  fi
  sed -i "s/# INFERNA_ADHOC_PACKAGES_START/# INFERNA_ADHOC_PACKAGES_START\n    ${pkg}/" "$adhoc_file"
  added+=("$pkg")
done
if (( ${#added[@]} == 0 )); then
  echo -e "\e[34m[Inferna]\e[0m Already declared: $*"
  exit 0
fi
echo -e "\e[34m[Inferna]\e[0m Added to packages-adhoc.nix: ${added[*]}"
sudo nixos-rebuild switch --flake "$flake_dir" || exit 1
exit 0
