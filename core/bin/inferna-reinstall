#!/usr/bin/env bash

# inferna:summary=Reset default configs
# inferna:requires-sudo=true

set -e

echo -e "This will reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reset and lose config changes?"; then
  inferna-reinstall-configs

  gum confirm "Configs have been reset. Reboot?" && inferna-system reboot
fi
