#!/usr/bin/env bash

# inferna:summary=Remove Dropbox and its bar plugin.
# inferna:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
inferna-plugin-disable inferna.dropbox
inferna-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox libappindicator

echo ""
echo "Dropbox has been removed."
