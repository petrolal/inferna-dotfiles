#!/usr/bin/env bash

# inferna:summary=Remove Dropbox and its bar plugin.
# inferna:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
inferna-plugin-disable omarchy.dropbox
inferna-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Other tray apps need libappindicator too, and naming a required package fails the whole removal
if pacman -Qqtt libappindicator &>/dev/null; then
  inferna-pkg-drop libappindicator
fi

echo ""
echo "Dropbox has been removed."
