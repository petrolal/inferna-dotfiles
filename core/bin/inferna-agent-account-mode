#!/usr/bin/env bash

# inferna:summary=Switch Claude, Codex, or Grok accounts automatically near a limit, or only notify
# inferna:args=[claude|codex|grok] [manual|auto] [threshold]
# inferna:examples=inferna agent account mode auto | inferna agent account mode auto 90 | inferna agent account mode codex manual

set -uo pipefail

# The provider can be left out when it's your default agent:
# `inferna agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(inferna-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  echo "Usage: inferna-agent-account-mode [claude|codex|grok] [manual|auto] [threshold]" >&2
  exit 1
fi

if [[ -n ${2:-} ]]; then
  inferna-agent-account-state mode "$@" || exit 1
fi

inferna-agent-account-state registry "$1" | jq -r '
  if .switch == "auto" then
    "\(.name) switches new sessions to the account with the most headroom at \(.threshold)%."
  else
    "\(.name) notifies at \(.threshold)% and switches when you say so."
  end'
