#!/usr/bin/env bash

# inferna:summary=Remove or uninstall the selected launcher entry
# inferna:args=<desktop-id> <name>
# inferna:hidden=true
# inferna:requires-sudo=true

set -e

desktop_id="${1-}"
entry_name="${2-}"

if [[ -z $desktop_id ]]; then
  echo "Usage: inferna-remove-launcher-entry <desktop-id> <name>" >&2
  exit 1
fi

desktop_file_name="$desktop_id"
if [[ $desktop_file_name != *.desktop ]]; then
  desktop_file_name="$desktop_file_name.desktop"
fi

user_desktop_dirs=()
desktop_dirs=()
if [[ -n ${XDG_DATA_HOME-} ]]; then
  user_desktop_dirs+=("$XDG_DATA_HOME/applications")
else
  user_desktop_dirs+=("$HOME/.local/share/applications")
fi
desktop_dirs+=("${user_desktop_dirs[@]}")

if [[ -n ${XDG_DATA_DIRS-} ]]; then
  IFS=: read -ra data_dirs <<<"$XDG_DATA_DIRS"
  for data_dir in "${data_dirs[@]}"; do
    desktop_dirs+=("$data_dir/applications")
  done
else
  desktop_dirs+=("/usr/local/share/applications" "/usr/share/applications")
fi

desktop_file=""
for dir in "${desktop_dirs[@]}"; do
  candidate="$dir/$desktop_file_name"
  if [[ -f $candidate ]]; then
    desktop_file="$candidate"
    break
  fi
done

if [[ -z $desktop_file ]]; then
  echo "Could not find launcher entry: $desktop_file_name" >&2
  exit 1
fi

is_user_desktop_file() {
  local dir desktop_dir

  desktop_dir="${desktop_file%/*}"
  for dir in "${user_desktop_dirs[@]}"; do
    [[ $desktop_dir == $dir ]] && return 0
  done

  return 1
}

desktop_name="${desktop_file##*/}"
desktop_name="${desktop_name%.desktop}"
exec_line="$(sed -n 's/^Exec=//p' "$desktop_file" | head -1)"

if [[ $exec_line =~ inferna-launch-webapp|inferna-webapp-handler ]]; then
  INFERNA_REMOVE_NOTIFY=false inferna-webapp-remove "$desktop_name"
  exit 0
fi

if [[ $exec_line =~ (^|[[:space:]])(\$TERMINAL|xdg-terminal-exec)[[:space:]].*-e([[:space:]]|$) ]]; then
  INFERNA_REMOVE_NOTIFY=false inferna-tui-remove "$desktop_name"
  exit 0
fi

if [[ $desktop_file_name == "slack.desktop" && $exec_line =~ ^inferna-launch-slack($|[[:space:]]) ]]; then
  exec inferna-launch-floating-terminal-with-presentation inferna-remove-service-slack
fi

if is_user_desktop_file; then
  display_name="${entry_name:-$desktop_name}"
  rm -f "$desktop_file"
  update-desktop-database "${desktop_file%/*}" &>/dev/null || true
  exit 0
fi

if inferna-cmd-present flatpak && flatpak info "${desktop_file_name%.desktop}" >/dev/null 2>&1; then
  flatpak_id="${desktop_file_name%.desktop}"
  quoted_flatpak="$(printf '%q' "$flatpak_id")"
  exec inferna-launch-floating-terminal-with-presentation "flatpak uninstall $quoted_flatpak"
fi

if flake_dir="$(inferna-nixos-flake-dir 2>/dev/null)"; then
  adhoc_file="$flake_dir/modules/packages-adhoc.nix"
  target_pkg=""
  if [[ -f $adhoc_file ]]; then
    clean_name="$(echo "$desktop_name" | tr '[:upper:]' '[:lower:]')"
    if grep -qE "^\s*${clean_name}\s*$" "$adhoc_file"; then
      target_pkg="$clean_name"
    else
      target_path="$(readlink -f "$desktop_file" 2>/dev/null || true)"
      if [[ $target_path =~ ^/nix/store/[a-z0-9]+-([^/]+)/ ]]; then
        pname_ver="${BASH_REMATCH[1]}"
        while read -r line; do
          pkg_candidate="$(echo "$line" | sed 's/#.*//' | xargs)"
          if [[ -n $pkg_candidate && $pname_ver =~ ^$pkg_candidate(-[0-9].*)?$ ]]; then
            target_pkg="$pkg_candidate"
            break
          fi
        done < "$adhoc_file"
      fi
    fi
  fi

  if [[ -n $target_pkg ]]; then
    display_name="${entry_name:-$desktop_name}"
    quoted_display="$(printf '%q' "$display_name")"
    exec inferna-launch-floating-terminal-with-presentation "echo Uninstalling $quoted_display...; inferna-pkg-drop '$target_pkg'"
  fi
fi

real_path="$(readlink -f "$desktop_file" 2>/dev/null || true)"
if [[ $real_path == /nix/store/* ]]; then
  echo "Error: ${entry_name:-$desktop_name} is managed declaratively by your NixOS configuration." >&2
  echo "To remove it, delete it from your NixOS modules and rebuild (nixos-rebuild switch)." >&2
  exit 1
fi

echo "Don't know how to uninstall $desktop_file_name" >&2
exit 1
