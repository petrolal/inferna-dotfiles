#!/usr/bin/env bash

# inferna:summary=Remove Grok Bot along with its settings and data.
# inferna:requires-sudo=true

set -e

inferna-pkg-drop grok-bot

# Not ~/.grok: that is the Grok CLI, which is installed and used on its own.
rm -rf \
  "$HOME/.config/Grok Bot" \
  "$HOME/.grokbot"

echo ""
echo "Grok Bot has been removed."
