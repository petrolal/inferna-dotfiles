#!/usr/bin/env bash

# inferna:summary=Install lib32 graphics drivers (Vulkan + NVIDIA) for any detected GPUs.
# inferna:group=install
# inferna:name=gaming gpu-lib32
# inferna:requires-sudo=true

set -e

if [[ -f /etc/NIXOS ]]; then
  # hardware.graphics.enable32Bit is already declared unconditionally in
  # nixos/modules/hyprland.nix, and hardware.nvidia (nvidia.nix) pulls in the
  # matching 32-bit NVIDIA userspace automatically -- nothing to install.
  exit 0
fi

# lib32 drivers come from Arch's multilib repository, which only exists on
# x86_64. aarch64 runs Valve's native arm64 Steam client and needs none.
inferna-hw-x86 || exit 0

echo "Installing lib32 graphics drivers..."

PACKAGES=()

declare -A VULKAN_DRIVERS=(
  [Intel]=lib32-vulkan-intel
  [AMD]=lib32-vulkan-radeon
)
for vendor in "${!VULKAN_DRIVERS[@]}"; do
  if lspci | grep -iE "(VGA|Display).*$vendor" >/dev/null; then
    PACKAGES+=("${VULKAN_DRIVERS[$vendor]}")
  fi
done

if inferna-hw-nvidia-gsp; then
  PACKAGES+=(lib32-nvidia-utils)
elif inferna-hw-nvidia-without-gsp; then
  PACKAGES+=(lib32-nvidia-580xx-utils)
fi

if (( ${#PACKAGES[@]} > 0 )); then
  inferna-pkg-add "${PACKAGES[@]}"
fi
