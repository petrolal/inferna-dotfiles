#!/usr/bin/env bash

# inferna:summary=Launch the default coding agent with a prompt
# inferna:args=[--inline] <prompt...>
# inferna:examples=inferna agent prompt "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: inferna agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec inferna-agent "${inline[@]}" --prompt "$*"
