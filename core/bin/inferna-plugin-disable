#!/usr/bin/env bash

# inferna:summary=Disable a shell plugin
# inferna:group=plugin
# inferna:args=<id>

set -euo pipefail

fail() {
  echo "inferna-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: inferna plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(inferna-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: inferna-shell shell rescanPlugins"

echo "Disabled $id"
