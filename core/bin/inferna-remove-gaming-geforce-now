#!/usr/bin/env bash

# inferna:summary=Remove the GeForce NOW Flatpak app and its data.
# inferna:group=remove
# inferna:name=gaming geforce-now

set -e

if inferna-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
