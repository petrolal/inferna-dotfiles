#!/usr/bin/env bash

# inferna:summary=Uninstall Slack Desktop and clean up its theme integration
# inferna:hidden=true
# inferna:requires-sudo=true

set -euo pipefail

inferna-pkg-drop slack-desktop
override="$HOME/.local/share/applications/slack.desktop"
if [[ -f $override ]] && grep -qE '^Exec=inferna-launch-slack( |$)' "$override"; then
  rm "$override"
  update-desktop-database "${override%/*}"
fi
rm -rf "$HOME/.local/state/inferna/slack"
