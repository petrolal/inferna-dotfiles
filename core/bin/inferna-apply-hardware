#!/usr/bin/env bash

# inferna:summary=Apply Inferna hardware-specific packages and system configuration
# inferna:group=apply
# inferna:requires-sudo=true
# inferna:examples=inferna apply hardware --install-user dhh
# inferna:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: inferna apply hardware --install-user USER
       inferna apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by inferna-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/inferna/provisioning/groups.

In an image build (/var/lib/inferna/image/target exists) nothing runs here: every step is queued
for inferna-provision-hardware on the machine's first boot.
USAGE
}

install_user="${INFERNA_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: inferna-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export INFERNA_INSTALL_USER="$install_user"
# Only inferna-provision-hardware runs steps as an image's first boot.
unset INFERNA_IMAGE_DEFERRED_HARDWARE
export INFERNA_PATH="$INFERNA_PATH"
export INFERNA_PATH="${INFERNA_PATH:-/usr/share/inferna}"
export INFERNA_INSTALL="${INFERNA_INSTALL:-$INFERNA_PATH/install}"
export INFERNA_INSTALL_LOG_FILE="${INFERNA_INSTALL_LOG_FILE:-/var/log/inferna-install.log}"
export PATH="$INFERNA_PATH/bin:$PATH"

source "$INFERNA_INSTALL/helpers/logging.sh"
source "$INFERNA_INSTALL/helpers/image-target.sh"

inferna_image_init
inferna_image_lock
if inferna_image_manifest_present; then
  inferna_image_read_manifest
  inferna_image_defer_hardware
else
  source "$INFERNA_INSTALL/hardware/all.sh"
fi
