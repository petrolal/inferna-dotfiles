#!/usr/bin/env bash

# inferna:summary=Install and configure Hex dictation
# inferna:requires-sudo=true

set -e

inferna-pkg-add hex
# Download the speech model here, with progress, instead of silently on first launch.
hex model install
systemctl --user enable hex.service
# Launching through the CLI saves this session's display environment for the unit before starting it.
hex start
inferna-dictation-use hex
inferna-restart-hyprctl
inferna-notification-send -g  "$(inferna-i18n dictation.hexReady)" "$(inferna-i18n dictation.hint)" -t 10000
