#!/usr/bin/env bash

# inferna:summary=Show which theme is styling the Plymouth boot screen
# inferna:examples=inferna plymouth current

# inferna-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/omarchy/logo.png

if cmp -s "$INFERNA_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

inferna-plymouth-list | while read -r name; do
  if cmp -s "$(inferna-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
