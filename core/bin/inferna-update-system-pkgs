#!/usr/bin/env bash

# inferna:summary=Update system packages via nixos-rebuild
# inferna:requires-sudo=true

set -e

echo -e "\e[32m\nUpdate system packages\e[0m"
echo -e "\e[32m\n[Inferna] Updating NixOS system configuration\e[0m"
if flake_dir=$(inferna-nixos-flake-dir); then
  sudo nixos-rebuild switch --flake "$flake_dir"
else
  sudo nixos-rebuild switch
fi
