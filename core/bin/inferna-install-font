#!/usr/bin/env bash

# inferna:summary=Install a Nerd Font package and switch the system to it
# inferna:args=<display-name> <package> <family>
# inferna:examples=inferna install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: inferna-install-font <display-name> <package> <family>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec inferna-launch-floating-terminal-with-presentation \
  "echo ${install_message}; inferna-pkg-add ${package_arg} && sleep 2 && inferna-font-set ${family_arg}"
