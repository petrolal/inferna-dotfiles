#!/usr/bin/env bash

# inferna:summary=Check whether Inferna updates are available.

set -euo pipefail

updates=()

if [[ $INFERNA_PATH != "/usr/share/inferna" ]]; then
  upstream=$(git -C "$INFERNA_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$INFERNA_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$INFERNA_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("inferna-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi


if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Inferna is up to date"
  exit 1
fi
