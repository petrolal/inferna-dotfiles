#!/usr/bin/env bash

# inferna:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# inferna:args=<packages...>

for pkg in "$@"; do
  if command -v "$pkg" &>/dev/null; then
    continue
  fi
  if command -v pacman &>/dev/null && pacman -Q -- "$pkg" &>/dev/null; then
    continue
  fi
  # NixOS profile check
  if nix-env -q "$pkg" &>/dev/null || nix profile list 2>/dev/null | grep -q "$pkg"; then
    continue
  fi
  exit 1
done

exit 0
