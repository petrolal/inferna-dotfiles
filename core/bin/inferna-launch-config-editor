#!/usr/bin/env bash

# inferna:summary=Open a config file in the user's editor and surface a toast
# inferna:args=<path>
# inferna:examples=inferna launch config-editor ~/.config/hypr/hyprland.lua

path="${1-}"

if [[ -z $path ]]; then
  echo "Usage: inferna-launch-config-editor <path>" >&2
  exit 1
fi

inferna-notification-send -u low "$(inferna-i18n config.editing)" "$path"
exec inferna-launch-editor "$path"
