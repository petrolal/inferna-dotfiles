#!/usr/bin/env bash

# inferna:summary=Edit, set, or reset About branding
# inferna:group=branding
# inferna:name=about
# inferna:args=<image|text|reset>
# inferna:examples=inferna branding about image | inferna branding about text | inferna branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(inferna-file-select --title "$(inferna-i18n branding.pickAboutImage)" --extensions "png svg")
  if inferna-transcode-ascii "$image" ~/.config/inferna/branding/about.txt --width 54 --height 26; then
    inferna-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  inferna-launch-editor ~/.config/inferna/branding/about.txt >/dev/null 2>&1 && inferna-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/icon.txt" ~/.config/inferna/branding/about.txt && inferna-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: inferna-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
