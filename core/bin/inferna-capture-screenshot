#!/usr/bin/env bash

# inferna:summary=Take a screenshot
# inferna:group=capture
# inferna:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# inferna:examples=inferna screenshot | inferna capture screenshot region
# inferna:aliases=inferna screenshot

if [[ -n ${INFERNA_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$INFERNA_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   inferna-i18n capture.screenshotSaved, inferna-i18n capture.screenshotSavedCopied,
#   inferna-i18n capture.screenshotOpen, inferna-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

if command -v omasnap &>/dev/null; then
  exec omasnap "${omasnap_args[@]}"
fi

mode="region"
action="both"

for arg in "$@"; do
  case "$arg" in
    copy) action="copy" ;;
    save) action="save" ;;
    fullscreen) mode="fullscreen" ;;
    smart|region|windows) mode="region" ;;
  esac
done

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
save_dir="${INFERNA_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}"
mkdir -p "$save_dir"
target_file="$save_dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

if [[ $mode == "fullscreen" ]]; then
  grim "$target_file" || exit 1
else
  geom=$(slurp 2>/dev/null)
  [[ -z $geom ]] && exit 0
  grim -g "$geom" "$target_file" || exit 1
fi

if [[ $action == "copy" || $action == "both" ]]; then
  wl-copy < "$target_file" 2>/dev/null || true
fi

if [[ $action == "copy" ]]; then
  notify-send -i "$target_file" "Screenshot" "Copied to clipboard" 2>/dev/null || true
  rm -f "$target_file"
else
  notify-send -i "$target_file" "Screenshot" "Saved to $(basename "$target_file") and copied to clipboard" 2>/dev/null || true
fi
