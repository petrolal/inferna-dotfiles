#!/usr/bin/env bash

# inferna:summary=Take a screenshot
# inferna:group=capture
# inferna:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# inferna:examples=inferna screenshot | inferna capture screenshot region
# inferna:aliases=inferna screenshot

if [[ -n ${OMARCHY_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$OMARCHY_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   inferna-i18n capture.screenshotSaved, inferna-i18n capture.screenshotSavedCopied,
#   inferna-i18n capture.screenshotOpen, inferna-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
