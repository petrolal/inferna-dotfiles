#!/usr/bin/env bash

# inferna:summary=Remove Steam and all of its game libraries, configs, and caches.
# inferna:requires-sudo=true

set -e

inferna-lifecycle-dispatch pre-remove steam
inferna-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
