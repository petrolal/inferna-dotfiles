#!/usr/bin/env bash

# inferna:summary=Review and optionally remove orphaned system packages after updates
# inferna:args=[-y]
# inferna:examples=inferna update orphan-pkgs | inferna update orphan-pkgs -y
# inferna:requires-sudo=true

set -e

mapfile -t orphans < <(pacman -Qtdq 2>/dev/null || true)
(( ${#orphans[@]} )) || exit 0

echo -e "\e[32m\nOrphan system packages\e[0m"
printf '  %s\n' "${orphans[@]}"
echo

if [[ ${1:-} != "-y" && ( ! -t 0 || ! -t 1 ) ]]; then
  echo "${#orphans[@]} orphaned package(s) found. Re-run inferna-update-orphan-pkgs in a terminal to review/remove them."
  echo
  exit 0
fi

if [[ ${1:-} != "-y" ]] && ! gum confirm --default=false --affirmative "$(inferna-i18n common.yes)" --negative "$(inferna-i18n common.no)" "$(inferna-i18n --count "${#orphans[@]}" update.removeOrphans "${#orphans[@]}")"; then
  echo "Keeping orphaned packages."
  echo
  exit 0
fi

echo -e "\e[32m\nRemoving orphan system packages\e[0m"
inferna-pkg-drop "${orphans[@]}"
echo
