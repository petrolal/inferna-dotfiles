#!/usr/bin/env bash

# inferna:summary=Open the Omarchy Discord community in the Discord app or a browser.

invite="https://discord.gg/tXFUdasqhY"

if inferna-cmd-present discord; then
  exec setsid uwsm-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec inferna-launch-webapp "$invite"
fi
