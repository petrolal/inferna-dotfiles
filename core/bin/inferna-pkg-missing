#!/usr/bin/env bash

# inferna:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# inferna:args=<packages...>

for pkg in "$@"; do
  if ! command -v "$pkg" &>/dev/null && ! nix profile list 2>/dev/null | grep -q "$pkg"; then
    exit 0
  fi
done

exit 1
