#!/usr/bin/env bash

# inferna:summary=Prompt for required reboot or service restarts after updates
# inferna:args=[--services-only|--reboot-only]

mode="${1:-all}"
case "$mode" in
  all|--services-only|--reboot-only) ;;
  *) echo "Unknown restart phase: $mode" >&2; exit 2 ;;
esac

echo
confirm_reboot() {
  if [[ ${INFERNA_UPDATE_UNATTENDED:-0} == "1" ]]; then
    echo "$1 Run inferna-system reboot when ready."
  elif gum confirm --affirmative "$(inferna-i18n common.yes)" --negative "$(inferna-i18n common.no)" "$1"; then
    inferna-system reboot
    exit 0
  fi
}

if [[ $mode != "--services-only" ]]; then
  # /run/booted-system is the generation actually running; /run/current-system
  # is the one `nixos-rebuild switch` last activated. They share a kernel
  # store path until a switch changes it, so a reboot is needed exactly when
  # the two diverge -- the NixOS equivalent of comparing `uname -r` against
  # the package manager's installed kernel.
  booted_kernel=$(readlink -f /run/booted-system/kernel 2>/dev/null)
  current_kernel=$(readlink -f /run/current-system/kernel 2>/dev/null)
  kernel_updated=false
  [[ -n $booted_kernel && -n $current_kernel && $booted_kernel != "$current_kernel" ]] && kernel_updated=true

  if [[ $kernel_updated == "true" ]]; then
    confirm_reboot "$(inferna-i18n update.kernelReboot)"
  elif [[ -f $HOME/.local/state/inferna/reboot-required ]]; then
    confirm_reboot "$(inferna-i18n update.rebootRequired)"
  fi

  running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
  if [[ $running_hyprland == *"(deleted)"* ]]; then
    confirm_reboot "$(inferna-i18n update.hyprlandReboot)"
  fi
fi

if [[ $mode != "--reboot-only" ]]; then
  for file in "$HOME"/.local/state/inferna/restart-*-required; do
    if [[ -f $file ]]; then
      filename=$(basename "$file")
      service=$(echo "$filename" | sed 's/restart-\(.*\)-required/\1/')
      echo "Restarting $service"
      inferna-state clear "$filename"
      inferna-restart-"$service"
    fi
  done

  # Updates routinely replace the shell's QML, and a stale process can lazy-load
  # new files into old code. A restart failure (locked session, ssh, TTY) only
  # prints its reason: the next update or login gets a fresh shell anyway.
  echo -e "\e[32m\nRestarting shell\e[0m"
  echo "All plugins have been reloaded"
  inferna-restart-shell || true
fi
