#!/usr/bin/env bash

# inferna:summary=Install Slack Desktop with live Inferna theme support
# inferna:requires-sudo=true

set -euo pipefail

inferna-pkg-add slack
if inferna-setup-slack; then
  setsid uwsm-app -- gtk-launch slack >/dev/null 2>&1 &
else
  echo "Slack theme setup failed; opening packaged Slack." >&2
  setsid uwsm-app -- gio launch /usr/share/applications/slack.desktop >/dev/null 2>&1 &
fi
