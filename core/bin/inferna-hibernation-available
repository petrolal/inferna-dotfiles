#!/usr/bin/env bash

# inferna:summary=Check if hibernation is supported

SYS_POWER_PATH="${INFERNA_SYS_POWER_PATH:-/sys/power}"
SWAPS_PATH="${INFERNA_SWAPS_PATH:-/proc/swaps}"
CMDLINE_PATH="${INFERNA_CMDLINE_PATH:-/proc/cmdline}"

if [[ ! -r $SYS_POWER_PATH/state || ! -r $SYS_POWER_PATH/image_size ]]; then
  exit 1
fi

# The kernel drops "disk" from the sleep states whenever it will refuse the
# request outright: lockdown, nohibernate, secretmem or an active CXL device.
SLEEP_STATES=" $(<"$SYS_POWER_PATH/state") "

if [[ $SLEEP_STATES != *" disk "* ]]; then
  exit 1
fi

# Sum all swap sizes (excluding zram)
SWAPSIZE_KB=$(awk '!/Filename|zram/ {sum += $3} END {print sum+0}' "$SWAPS_PATH")
SWAPSIZE=$(( 1024 * ${SWAPSIZE_KB:-0} ))

HIBERNATION_IMAGE_SIZE=$(<"$SYS_POWER_PATH/image_size")

# A size that did not read is worth zero to the comparison below, and any swap
# at all beats zero.
if [[ ! $HIBERNATION_IMAGE_SIZE =~ ^[0-9]+$ ]]; then
  exit 1
fi

# Resume is wired up via a `resume=` kernel parameter (NixOS sets this
# through boot.resumeDevice/boot.kernelParams; Arch's mkinitcpio resume hook
# does the same) rather than through any distro-specific config file, so
# checking the actual kernel cmdline works everywhere.
if (( SWAPSIZE > HIBERNATION_IMAGE_SIZE )) && grep -qw 'resume=' "$CMDLINE_PATH" 2>/dev/null; then
  exit 0
else
  exit 1
fi
