#!/usr/bin/env bash

# inferna:summary=Print debugging information
# inferna:args=[--no-sudo] [--print]
# inferna:examples=inferna debug --print --no-sudo
# inferna:requires-sudo=true

NO_SUDO=false
PRINT_ONLY=false

while (( $# > 0 )); do
  case "$1" in
    --no-sudo)
      NO_SUDO=true
      shift
      ;;
    --print)
      PRINT_ONLY=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: inferna-debug [--no-sudo] [--print]"
      exit 1
      ;;
  esac
done

LOG_FILE="/tmp/inferna-debug.log"

if [[ $NO_SUDO = "true" ]]; then
  DMESG_OUTPUT="(skipped - --no-sudo flag used)"
else
  DMESG_OUTPUT="$(sudo dmesg)"
fi

cat > "$LOG_FILE" <<EOF
Date: $(date)
Hostname: $(hostname)
Inferna Version: $(inferna-version 2>/dev/null || echo "unknown")
NixOS Version: $(nixos-version 2>/dev/null || echo "unknown")

=========================================
SYSTEM INFORMATION
=========================================
$(inxi -Farz 2>/dev/null || (inferna-cmd-present fastfetch && fastfetch --logo none --pipe 2>/dev/null) || uname -a)

=========================================
DMESG
=========================================
$DMESG_OUTPUT

=========================================
JOURNALCTL (CURRENT BOOT, WARNINGS+ERRORS)
=========================================
$(journalctl -b -p 4..1)

=========================================
INSTALLED PACKAGES (NixOS system profile)
=========================================
$(nix-store -q --references /run/current-system/sw 2>/dev/null | sed 's|^/nix/store/[^-]*-||' | sort)
EOF

if [[ $PRINT_ONLY = "true" ]]; then
  cat "$LOG_FILE"
  exit 0
fi

OPTIONS=("View log" "Save in current directory")
if ping -c 1 8.8.8.8 >/dev/null 2>&1; then
  OPTIONS=("Upload log" "${OPTIONS[@]}")
fi

ACTION=$(gum choose "${OPTIONS[@]}")

case "$ACTION" in
  "Upload log")
    echo "Uploading debug log..."
    URL=$(curl -sf -F "file=@$LOG_FILE" -Fexpires=24 https://logs.inferna.org/ 2>/dev/null || curl -sf -F "file=@$LOG_FILE" -Fexpires=24 https://logs.omarchy.org/ 2>/dev/null || curl -sf -F "file=@$LOG_FILE" https://0x0.st 2>/dev/null || true)
    if (( $? == 0 )) && [[ -n $URL ]]; then
      echo "✓ Log uploaded successfully!"
      echo "Share this URL:"
      echo ""
      echo "  $URL"
    else
      echo "Error: Failed to upload log file"
      exit 1
    fi
    ;;
  "View log")
    less "$LOG_FILE"
    ;;
  "Save in current directory")
    cp "$LOG_FILE" "./inferna-debug.log"
    echo "✓ Log saved to $(pwd)/inferna-debug.log"
    ;;
esac
