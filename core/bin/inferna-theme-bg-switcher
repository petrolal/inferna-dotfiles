#!/usr/bin/env bash

# inferna:summary=Open the Inferna background switcher
# inferna:group=theme
# inferna:name=bg-switcher
# inferna:aliases=inferna background

theme_name=$(cat "$HOME/.local/state/inferna/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/inferna/current/background" 2>/dev/null)

inferna-menu-images \
  --selected "$current_background" \
  "$HOME/.local/state/inferna/current/theme/backgrounds" \
  "$HOME/.config/inferna/backgrounds/$theme_name"
