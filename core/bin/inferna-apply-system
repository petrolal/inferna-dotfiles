#!/usr/bin/env bash

# inferna:summary=Apply Inferna system setup in the installed target
# inferna:group=apply
# inferna:requires-sudo=true
# inferna:examples=inferna apply system --install-user dhh --first-install
# inferna:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: inferna apply system --install-user USER [--first-install|--upgrade]
       inferna apply system --defer-provisioning --first-install

Runs root-owned Inferna system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
inferna-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/inferna/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${INFERNA_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: inferna-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export INFERNA_INSTALL_USER="$install_user"
export INFERNA_FIRST_INSTALL="$first_install"
export INFERNA_UPGRADE="$upgrade"
export INFERNA_PATH="$INFERNA_PATH"
export INFERNA_PATH="${INFERNA_PATH:-/usr/share/inferna}"
export INFERNA_INSTALL="${INFERNA_INSTALL:-$INFERNA_PATH/install}"
export INFERNA_INSTALL_LOG_FILE="${INFERNA_INSTALL_LOG_FILE:-/var/log/inferna-install.log}"
export PATH="$INFERNA_PATH/bin:$PATH"

source "$INFERNA_INSTALL/helpers/logging.sh"
start_install_log

source "$INFERNA_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  inferna-apply-hardware --defer-provisioning
else
  inferna-apply-hardware --install-user "$install_user"
fi

source "$INFERNA_INSTALL/login/all.sh"
source "$INFERNA_INSTALL/post-install/all.sh"

stop_install_log
