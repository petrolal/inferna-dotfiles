#!/usr/bin/env bash

# inferna:summary=Install Lutris with Wine + DXVK for running Windows games (Battle.net, EA, Ubisoft Connect, etc.)
# inferna:requires-sudo=true

set -e

echo "Installing Lutris..."
if [[ -f /etc/NIXOS ]]; then
  # Declared by nixos/modules/gaming.nix (lutris, umu-launcher; 32-bit
  # graphics handled there too). Lutris fetches its own Wine/DXVK runners at
  # runtime, so no system wine-staging/winetricks is needed, and nixpkgs'
  # lutris is already wrapped with its own Python -- the Arch shebang patch
  # below doesn't apply.
  if ! flake_dir=$(inferna-nixos-flake-dir); then
    echo -e "\033[31mError: could not find a NixOS flake directory.\033[0m" >&2
    exit 1
  fi
  sudo nixos-rebuild switch --flake "$flake_dir"
else
  # Satisfy umu-launcher's lib32-vulkan-driver dependency before --noconfirm
  # can select an NVIDIA provider on an AMD or Intel system.
  inferna-install-gaming-gpu-lib32
  inferna-pkg-add lutris umu-launcher wine-staging wine-mono wine-gecko winetricks python-protobuf

  # Lutris ships with `#!/usr/bin/env python3`, which resolves to mise's Python and
  # fails to import the lutris module. Pin the shebang to the system Python.
  sudo sed -i '/env python3/ c\#!/bin/python3' /usr/bin/lutris
fi

cat <<'EOF'

Lutris will open and auto-fetch its DXVK and VKD3D runtimes in the background
(watch the bottom status bar). Once that finishes, click the + to add or install games.

EOF

setsid lutris >/dev/null 2>&1 &
