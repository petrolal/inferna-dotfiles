#!/usr/bin/env bash

# inferna:summary=Edit, set, or reset screensaver branding
# inferna:group=branding
# inferna:name=screensaver
# inferna:args=<image|text|reset>
# inferna:examples=inferna branding screensaver image | inferna branding screensaver text | inferna branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(inferna-file-select --title "$(inferna-i18n branding.pickScreensaverImage)" --extensions "png svg")
  if inferna-transcode-ascii "$image" ~/.config/inferna/branding/screensaver.txt; then
    inferna-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  inferna-launch-editor ~/.config/inferna/branding/screensaver.txt >/dev/null 2>&1 && inferna-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$INFERNA_PATH/logo.txt" ~/.config/inferna/branding/screensaver.txt && inferna-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: inferna-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
