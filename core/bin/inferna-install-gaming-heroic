#!/usr/bin/env bash

# inferna:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# inferna:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
inferna-pkg-add heroic-games-launcher-bin
inferna-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
