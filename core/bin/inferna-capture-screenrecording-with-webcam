#!/usr/bin/env bash

# inferna:summary=Pick a webcam and start a screen recording with it
# inferna:examples=inferna capture screenrecording-with-webcam

mapfile -t devices < <(inferna-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  inferna-notification-send "$(inferna-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(inferna-menu-select "$(inferna-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec inferna-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
