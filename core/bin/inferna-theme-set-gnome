#!/usr/bin/env bash

# inferna:summary=Apply the current theme to GNOME color mode and icon settings
# inferna:hidden=true

# gsettings needs a user DBus session. During ISO installs this command can be
# reached from arch-chroot while applying the initial Inferna theme; defer until
# the user has a real session instead of emitting dconf warnings.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  exit 0
fi

# Locate gsettings executable
GSETTINGS_BIN=$(command -v gsettings 2>/dev/null)
if [[ -z $GSETTINGS_BIN ]]; then
  for candidate in /nix/store/*-glib-*-bin/bin/gsettings; do
    if [[ -x $candidate ]]; then
      GSETTINGS_BIN="$candidate"
      break
    fi
  done
fi

if [[ -z $GSETTINGS_BIN ]]; then
  exit 0
fi

# Ensure schema dir is found if not already in XDG_DATA_DIRS
if [[ -z ${GSETTINGS_SCHEMA_DIR:-} ]]; then
  for sdir in /nix/store/*-gsettings-desktop-schemas-*/share/gsettings-schemas/*/glib-2.0/schemas; do
    if [[ -d $sdir ]]; then
      export GSETTINGS_SCHEMA_DIR="$sdir"
      break
    fi
  done
fi

run_gsettings() {
  "$GSETTINGS_BIN" "$@" 2>/dev/null || true
}

THEME_DIR=$HOME/.local/state/inferna/current/theme
COLORS_FILE="$THEME_DIR/colors.toml"

# inferna-theme-color resolves mode from colors.toml (`mode = "light"`), a
# legacy light.mode marker beside it, or background luminance for user themes.
mode=$(inferna-theme-color --file "$COLORS_FILE" mode)

if [[ $mode == "light" ]]; then
  run_gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  run_gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
else
  run_gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  run_gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
fi

# Change gnome icon theme color
GNOME_ICONS_THEME=$HOME/.local/state/inferna/current/theme/icons.theme
if [[ -f $GNOME_ICONS_THEME ]]; then
  run_gsettings set org.gnome.desktop.interface icon-theme "$(<$GNOME_ICONS_THEME)"
else
  run_gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue"
fi

exit 0
