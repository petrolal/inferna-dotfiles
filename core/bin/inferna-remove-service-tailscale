#!/usr/bin/env bash

# inferna:summary=Remove Tailscale and its bar plugin.
# inferna:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now inferna-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
inferna-plugin-disable omarchy.tailscale
inferna-webapp-remove "Tailscale" 2>/dev/null || true
inferna-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
