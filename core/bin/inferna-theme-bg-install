#!/usr/bin/env bash

# inferna:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/inferna/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/inferna/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
