#!/usr/bin/env bash

# inferna:summary=Restore the preinstalled Inferna applications (web apps, TUIs, and selected packages).
# inferna:requires-sudo=true

if gum confirm --affirmative "$(inferna-i18n common.yes)" --negative "$(inferna-i18n common.no)" "$(inferna-i18n preinstalls.confirmRestore)"; then
  echo -e "Restoring preinstalled Inferna applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs).
  inferna-refresh-applications || exit 1

  # Re-enable Inferna's default mise tools for this user and rebuild their shims.
  if ! inferna-mise-default-tools enable; then
    echo -e "\nCould not restore mise tools. Preinstalls remain marked as removed."
    exit 1
  fi

  # Mirrors the list in inferna-remove-preinstalls; both track inferna-base.packages
  if ! inferna-pkg-add \
    aether \
    cliamp \
    libreoffice-fresh \
    pinta \
    obsidian \
    moonlight-qt \
    omacut \
    monologue \
    omacalc \
    omawrite \
    hype \
    signed; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/inferna/preinstalls-removed
  inferna-restart-hyprctl
fi
