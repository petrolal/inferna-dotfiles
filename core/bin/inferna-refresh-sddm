#!/usr/bin/env bash

# inferna:summary=Refresh the SDDM theme from default
# inferna:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves an untrusted source or
# follows a destination symlink while restoring the packaged SDDM theme.
exec "$INFERNA_PATH/bin/inferna-plymouth-set" --refresh-sddm-default
