#!/usr/bin/env bash

# inferna:summary=Remove the official TETR.IO Desktop app.

set -e

rm -rf "$HOME/.local/share/tetrio-desktop"
rm -f "$HOME/.local/share/applications/TETR.IO.desktop"
rm -f "$HOME/.local/share/icons/hicolor/256x256/apps/tetrio.png"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
