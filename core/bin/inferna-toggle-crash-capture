#!/usr/bin/env bash

# inferna:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

inferna-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if inferna-toggle-enabled crash-capture-off; then
  systemctl --user stop inferna-crash-watch.service
  inferna-notification-send -g "$CRASH_GLYPH" "$(inferna-i18n crash.captureDisabled)"
else
  systemctl --user start inferna-crash-watch.service
  inferna-notification-send -g "$CRASH_GLYPH" "$(inferna-i18n crash.captureEnabled)"
fi
