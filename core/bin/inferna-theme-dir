#!/usr/bin/env bash

# inferna:summary=Print the directory holding a theme, preferring a user-installed copy
# inferna:args=<theme-name>
# inferna:examples=inferna theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: inferna-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/inferna/themes/$theme ]]; then
  echo "$HOME/.config/inferna/themes/$theme"
else
  echo "$OMARCHY_PATH/themes/$theme"
fi
