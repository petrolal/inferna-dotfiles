#!/usr/bin/env bash

# inferna:summary=Remove Voxtype dictation and its configuration
# inferna:requires-sudo=true

set -e

# Remove voxtype and its configurations.

if inferna-cmd-present voxtype; then
  echo "Uninstall Voxtype to remove dictation."

  # Remove services
  systemctl --user disable --now voxtype.service 2>/dev/null || true
  systemctl --user daemon-reload

  # Remove packages and configs
  inferna-pkg-drop voxtype
  rm -rf ~/.config/voxtype
  rm -rf ~/.local/share/voxtype
  backend_config="${XDG_CONFIG_HOME:-$HOME/.config}/inferna/defaults/dictation"
  if [[ -f $backend_config && $(< "$backend_config") == "voxtype" ]]; then
    rm "$backend_config"
  fi
  inferna-restart-hyprctl
else
  echo "Voxtype was not installed."
fi
