#!/usr/bin/env bash

# inferna:summary=Print the active Inferna dev-link git branch
# inferna:hidden=true

inferna_path=${INFERNA_PATH:-/usr/share/inferna}
inferna_path=${inferna_path%/}

[[ $inferna_path != "/usr/share/inferna" ]] || exit 1

branch=$(git -C "$inferna_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$inferna_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
