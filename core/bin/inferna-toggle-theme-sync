#!/usr/bin/env bash

# inferna:summary=Toggle mirroring theme changes to and from your herdr machines

inferna-toggle herdr-theme-sync

if inferna-toggle-enabled herdr-theme-sync; then
  inferna-notification-send -g 󰸌 "$(inferna-i18n themeSync.enabled)"
else
  inferna-notification-send -g 󰸌 "$(inferna-i18n themeSync.disabled)"
fi
