#!/usr/bin/env bash

# inferna:summary=Enable or disable background intros
# inferna:args=<enable|disable|toggle|status>
# inferna:examples=inferna theme bg intro toggle | inferna theme bg intro disable

set -euo pipefail

toggle="$HOME/.local/state/inferna/toggles/background-intros-off"
case ${1:-} in
  enable)
    rm -f "$toggle"
    inferna-notification-send "$(inferna-i18n theme.backgroundIntros)" "$(inferna-i18n common.enabled)"
    ;;
  disable)
    mkdir -p "$(dirname "$toggle")"
    touch "$toggle"
    inferna-notification-send "$(inferna-i18n theme.backgroundIntros)" "$(inferna-i18n common.disabled)"
    ;;
  toggle)
    if [[ -f $toggle ]]; then
      inferna-theme-bg-intro enable
    else
      inferna-theme-bg-intro disable
    fi
    ;;
  status)
    [[ ! -f $toggle ]]
    ;;
  *)
    echo "Usage: inferna-theme-bg-intro <enable|disable|toggle|status>" >&2
    exit 1
    ;;
esac
