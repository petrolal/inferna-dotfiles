#!/usr/bin/env bash

# inferna:summary=Show idle, screensaver, and lock diagnostics
# inferna:group=debug
# inferna:args=[log-lines]
# inferna:examples=inferna debug idle | inferna-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
inferna-shell idle status 2>&1 | jq . 2>/dev/null || inferna-shell idle status 2>&1 || true

section "Quickshell instances"
quickshell list -p "$OMARCHY_PATH/shell" --any-display 2>&1 || true

section "Recent idle logs"
quickshell --no-color log -p "$OMARCHY_PATH/shell" --any-display --tail "$lines" --log-times -r 'quickshell.wayland.idle_notify=true' 2>&1 \
  | grep -Ei 'omarchy idle|idle_notify|screensaver|lock|error|warn|failed' || true

section "Persisted shell log"
journalctl -t inferna-shell -n "$lines" --no-pager --quiet 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quickshell -n -p|inferna-system-sleep-monitor|systemd-inhibit.*Lock screen before suspend|inferna-screensaver' \
  | grep -v grep || true

section "Sleep lock service"
systemctl --user status inferna-sleep-lock.service --no-pager 2>/dev/null || true

section "Hyprland screensaver layers"
hyprctl layers -j 2>/dev/null \
  | jq -r '.. | objects | select(.namespace? == "org.omarchy.screensaver") | [.pid,.namespace,.x,.y,.w,.h] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | select(.namespace? == "org.omarchy.screensaver")] | length > 0' >/dev/null; then
  echo "running-layer"
elif pgrep -f '[/]usr/lib/inferna-screensaver/inferna-screensaver' >/dev/null; then
  echo "running-process"
elif inferna-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
inferna-shell lock status 2>&1 | jq . 2>/dev/null || inferna-shell lock status 2>&1 || true
