#!/usr/bin/env bash

# inferna:summary=Launch a TUI or focus an existing terminal window for it
# inferna:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.inferna.$(basename "$1")"
fi

LAUNCH_COMMAND="inferna-launch-tui $@"

exec inferna-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
