#!/usr/bin/env bash

# inferna:summary=Ensure default application launchers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$INFERNA_PATH"/applications/*.desktop ~/.local/share/applications/

if inferna-cmd-present alacritty; then
  cp "$INFERNA_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications
