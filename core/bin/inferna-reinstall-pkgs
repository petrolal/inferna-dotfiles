#!/usr/bin/env bash

# inferna:summary=Reinstall all default Inferna packages from the stable channel, or on Apple Silicon the edge channel
# inferna:requires-sudo=true

set -e

# Reinstall all default Inferna packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$INFERNA_PATH/install/helpers/pacman.sh"
platform=$(inferna-hw-platform)
channel=$(inferna_pacman_default_channel "$platform")
inferna-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
inferna-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(inferna-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for inferna-power-profiles-daemon.
inferna-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
