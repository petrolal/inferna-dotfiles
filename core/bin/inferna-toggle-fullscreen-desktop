#!/usr/bin/env bash

# inferna:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# inferna:args=[toggle|on|off]
# inferna:examples=inferna toggle fullscreen desktop | inferna toggle fullscreen desktop off | inferna toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if inferna-toggle-enabled bar-off && inferna-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: inferna-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

inferna-toggle-bar "$ACTION"
inferna-hyprland-toggle window-no-gaps "$ACTION"
