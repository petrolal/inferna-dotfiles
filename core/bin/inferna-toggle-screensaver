#!/usr/bin/env bash

# inferna:summary=Toggle screensaver availability

inferna-toggle screensaver-off

if inferna-toggle-enabled screensaver-off; then
  inferna-notification-send -g 󱄄 "$(inferna-i18n screensaver.disabled)"
else
  inferna-notification-send -g 󱄄 "$(inferna-i18n screensaver.enabled)"
fi
