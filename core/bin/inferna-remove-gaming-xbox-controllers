#!/usr/bin/env bash

# inferna:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# inferna:group=remove
# inferna:name=gaming xbox-controllers
# inferna:requires-sudo=true

set -e

echo "Unloading xpadneo kernel module..."
sudo modprobe -r hid_xpadneo 2>/dev/null || true

echo ""
echo "Xbox controller support unloaded."
echo "Note: to disable it permanently across reboots, set hardware.xpadneo.enable = false in nixos/modules/gaming.nix."
