# Inferna Fish configuration (managed by inferna-dotfiles)
#
# - Dynamic rice paths & environment variables are generated into:
#     ~/.config/fish/conf.d/inferna-paths.fish   (regenerated by ./install.sh)
# - Put your personal / machine-local aliases, paths, and tweaks in:
#     ~/.config/fish/user-fish.fish              (never overwritten by ./install.sh)

if status is-interactive
    # Clean terminal startup (no default "Welcome to fish" banner)
    set -g fish_greeting

    # Inferna syntax highlighting palette (overridable in user-fish.fish)
    set -g fish_color_normal f2e5d5
    set -g fish_color_command f2a949
    set -g fish_color_keyword ff622e
    set -g fish_color_quote e8b878
    set -g fish_color_redirection ff622e
    set -g fish_color_end a69085
    set -g fish_color_error c8231a
    set -g fish_color_param f2e5d5
    set -g fish_color_valid_path --underline
    set -g fish_color_option f5c27a
    set -g fish_color_comment 8a756b
    set -g fish_color_selection --background=33231d
    set -g fish_color_search_match --background=3a221c
    set -g fish_color_operator d9381e
    set -g fish_color_escape ff622e
    set -g fish_color_autosuggestion 7c675d
    set -g fish_pager_color_progress a69085
    set -g fish_pager_color_prefix f2a949 --bold
    set -g fish_pager_color_completion f2e5d5
    set -g fish_pager_color_description a69085
    set -g fish_pager_color_selected_background --background=2d1e19

    # Starship prompt (configured via ~/.config/starship.toml)
    if command -q starship
        starship init fish | source
    end

    # Smart directory jumper (zoxide)
    if command -q zoxide
        zoxide init fish | source
    end

    # Inferna FZF theme (ember orange, crimson border, molten gold highlights)
    set -gx FZF_DEFAULT_OPTS "\
--color=bg+:#2b1b15,fg:#f2e5d5,fg+:#fff3e6,hl:#ff622e,hl+:#f2a949 \
--color=border:#a83219,prompt:#ff622e,pointer:#ff622e,marker:#f2a949 \
--color=spinner:#f2a949,header:#947a6c,info:#c99668,gutter:#18100d \
--border=rounded --height=45% --layout=reverse \
--prompt='󰈸 ' --pointer='❯' --marker='◆'"

    # Modern Inferna CLI aliases (overridable in user-fish.fish)
    if command -q eza
        set -gx EZA_COLORS "di=1;38;2;242;169;73:ln=38;2;255;124;58:ex=1;38;2;247;214;122:da=38;2;148;122;108:uu=38;2;232;139;58:gu=38;2;186;112;76:sn=38;2;255;98;46:sb=38;2;148;122;108:ga=38;2;242;169;73:gm=38;2;255;98;46:gd=38;2;217;56;30"
        alias ls "eza --icons=auto --group-directories-first"
        alias ll "eza -la --icons=auto --group-directories-first --git"
        alias la "eza -a --icons=auto --group-directories-first"
        alias lt "eza --tree --level=2 --icons=auto --group-directories-first"
    end

    if command -q bat
        alias cat "bat --paging=never"
    end

    # Yazi wrapper: press 'y' to browse files with Kitty image preview and cd on exit
    if command -q yazi
        function y
            set tmp (mktemp -t "yazi-cwd.XXXXXX")
            yazi $argv --cwd-file="$tmp"
            if set cwd (command cat -- "$tmp"); and [ -n "$cwd" ]; and [ "$cwd" != "$PWD" ]
                builtin cd -- "$cwd"
            end
            rm -f -- "$tmp"
        end
    end

    # Convenience aliases for full dashboard & live spinning high-res 3D GLSL ring
    alias dash "fastfetch"
    alias ring3d "inferna-ring --kitty --size 420 --cols 36 --rows 18 --animate"

    # Upload a seamless 360-deg looping 3D GLSL animation directly into Ghostty
    # alongside compact fastfetch and exit immediately (zero blocking, keeps spinning!).
    if test "$SHLVL" -le 1
        and test "$TERM_PROGRAM" = "ghostty"
        and not set -q INSIDE_EMACS
        and not set -q NVIM
        and not set -q TMUX
        and test "$COLUMNS" -ge 80
        and test "$LINES" -ge 18
        and command -q inferna-ring
        if command -q fastfetch; and test -f "$HOME/.config/fastfetch/compact.jsonc"
            env INFERNA_SHELL="fish $FISH_VERSION" inferna-ring --kitty-loop --size 256 --frames 240 --fps 33 --cols 32 --rows 16 \
                --side-cmd "fastfetch --config $HOME/.config/fastfetch/compact.jsonc"
        else
            inferna-ring --kitty-loop --size 256 --frames 240 --fps 33 --cols 32 --rows 16
        end
    end
end

# Load user-local customizations last so they can override rice defaults.
if test -f "$HOME/.config/fish/user-fish.fish"
    source "$HOME/.config/fish/user-fish.fish"
end
