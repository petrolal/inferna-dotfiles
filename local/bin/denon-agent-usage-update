#!/bin/bash
# Wrapper around inferna-agent-usage-update: every collector runs upstream
# except two:
#  - Codex uses ~/.local/share/denon-agent-usage/codex-collector.py (fixed RPC
#    reader, plus banked "Full reset" credits).
#  - Claude runs the upstream collector here, so claude.json is written once
#    (the panel's file watcher can miss a second quick rewrite).
# Same arguments as the upstream command.
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/inferna/agents/usage"
HELPERS="$HOME/.local/share/denon-agent-usage"
mkdir -p "$USAGE_DIR"
flags=(); only=(); excepts=(); want_codex=1; want_claude=1; args=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force | --limits-only) flags+=("$1") ;;
    --except) excepts+=("$2"); [[ $2 == codex ]] && want_codex=0; [[ $2 == claude ]] && want_claude=0; shift ;;
    *) only+=("$1") ;;
  esac
  shift
done
if (( ${#only[@]} )); then
  want_codex=0; want_claude=0
  for a in "${only[@]}"; do [[ $a == codex ]] && want_codex=1; [[ $a == claude ]] && want_claude=1; done
fi

write_record() { # agent json
  local tmp; tmp=$(mktemp "$USAGE_DIR/.$1.XXXXXX"); printf '%s\n' "$2" >"$tmp"; mv "$tmp" "$USAGE_DIR/$1.json"
}

status=0
pids=()

# Everything else upstream (skip it entirely when only codex/claude were asked for).
others=()
for a in "${only[@]}"; do [[ $a != codex && $a != claude ]] && others+=("$a"); done
if (( ${#only[@]} == 0 || ${#others[@]} > 0 )); then
  up=("${flags[@]}" --except codex --except claude)
  for e in "${excepts[@]}"; do up+=(--except "$e"); done
  inferna-agent-usage-update "${up[@]}" "${others[@]}" & pids+=($!)
fi

if (( want_codex )); then
  (
    if record=$(python3 "$HELPERS/codex-collector.py" "${flags[@]}") && jq -e . >/dev/null 2>&1 <<<"$record"; then
      write_record codex "$record"
    else
      echo "denon-agent-usage-update: codex collector failed" >&2; exit 1
    fi
  ) & pids+=($!)
fi

if (( want_claude )); then
  (
    collector="${INFERNA_PATH:-$HOME/inferna-dotfiles/core}/bin/inferna-agent-usage-claude"
    if record=$("$collector" "${flags[@]}") && jq -e . >/dev/null 2>&1 <<<"$record"; then
      write_record claude "$(jq -c 'del(.resetCredits)' <<<"$record")"
    else
      echo "denon-agent-usage-update: claude collector failed" >&2; exit 1
    fi
  ) & pids+=($!)
fi

for pid in "${pids[@]}"; do wait "$pid" || status=1; done
exit $status
